@model OrderManagementApp.Models.ViewModels.OrderViewModel

@{
    ViewData["Title"] = "Edit Order";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h2 class="mb-0">@ViewData["Title"]</h2>
                    <small class="text-muted">Order: @Model.OrderNumber</small>
                </div>
                <div class="card-body">
                    <!-- Success/Error Messages -->
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="Edit" id="editForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="OrderNumber" />
                        <input type="hidden" asp-for="OrderDate" />
                        <input type="hidden" asp-for="ProductId" />
                        
                        <!-- Read-only Fields -->
                        <div class="alert alert-info mb-3">
                            <div class="row">
                                <div class="col-md-6">
                                    <strong>Order Number:</strong><br>
                                    <span class="form-control-plaintext">@Model.OrderNumber</span>
                                </div>
                                <div class="col-md-6">
                                    <strong>Order Date:</strong><br>
                                    <span class="form-control-plaintext">@Model.OrderDate.ToString("yyyy-MM-dd")</span>
                                </div>
                            </div>
                        </div>

                        <!-- Product Info (Read-only) -->
                        <div class="alert alert-light mb-3">
                            <h6 class="alert-heading">Product Information</h6>
                            <div class="row">
                                <div class="col-md-6">
                                    <strong>Product:</strong><br>
                                    <span class="form-control-plaintext">@Model.ProductName</span>
                                </div>
                                <div class="col-md-3">
                                    <strong>Price:</strong><br>
                                    <span class="form-control-plaintext">$@Model.ProductPrice?.ToString("F2")</span>
                                </div>
                                <div class="col-md-3">
                                    <strong>Available Stock:</strong><br>
                                    <span class="form-control-plaintext">@Model.ProductStock</span>
                                </div>
                            </div>
                            <small class="text-muted">Product cannot be changed after order is created.</small>
                        </div>

                        <div class="row">
                            <!-- Customer Name -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="CustomerName" class="form-label"></label>
                                <input asp-for="CustomerName" class="form-control" />
                                <span asp-validation-for="CustomerName" class="text-danger small"></span>
                            </div>

                            <!-- Customer Email -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="CustomerEmail" class="form-label"></label>
                                <input asp-for="CustomerEmail" type="email" class="form-control" />
                                <span asp-validation-for="CustomerEmail" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <!-- Quantity -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="Quantity" class="form-label"></label>
                                <input asp-for="Quantity" type="number" class="form-control" 
                                       min="1" max="@Model.ProductStock" id="quantityInput" />
                                <span asp-validation-for="Quantity" class="text-danger small"></span>
                                <div id="quantityWarning" class="text-warning small mt-1 d-none">
                                    <i class="bi bi-exclamation-triangle"></i> 
                                    <span id="stockMessage"></span>
                                </div>
                            </div>

                            <!-- Delivery Date -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="DeliveryDate" class="form-label"></label>
                                <input asp-for="DeliveryDate" type="date" class="form-control" 
                                       min="@Model.OrderDate.ToString("yyyy-MM-dd")" 
                                       value="@(Model.DeliveryDate?.ToString("yyyy-MM-dd") ?? "")" />
                                <span asp-validation-for="DeliveryDate" class="text-danger small"></span>
                                <small class="form-text text-muted">
                                    Set delivery date to mark as delivered. Leave empty for pending.
                                </small>
                            </div>
                        </div>

                        <!-- Current Status -->
                        <div class="alert @(Model.DeliveryDate.HasValue ? "alert-success" : "alert-warning") mb-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>Current Status:</strong>
                                    @if (Model.DeliveryDate.HasValue)
                                    {
                                        <span class="badge bg-success ms-2">Delivered</span>
                                        <br>
                                        <small>Delivered on: @Model.DeliveryDate?.ToString("yyyy-MM-dd")</small>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning ms-2">Pending</span>
                                        <br>
                                        <small>Order placed: @Model.OrderDate.ToString("yyyy-MM-dd")</small>
                                    }
                                </div>
                                @if (Model.TotalPrice.HasValue)
                                {
                                    <div class="text-end">
                                        <strong>Total Price:</strong>
                                        <h4 class="mb-0">$@Model.TotalPrice?.ToString("F2")</h4>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Back to List
                            </a>
                            <div>
                                <button type="submit" class="btn btn-warning">
                                    <i class="bi bi-save"></i> Update Order
                                </button>
                                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-info ms-2">
                                    <i class="bi bi-eye"></i> View Details
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css"></script>
    <script>
        // Quantity validation
        document.getElementById('quantityInput').addEventListener('input', function() {
            const quantity = parseInt(this.value) || 0;
            const maxStock = @(Model.ProductStock ?? 0);
            const warning = document.getElementById('quantityWarning');
            const message = document.getElementById('stockMessage');
            
            if (quantity > maxStock) {
                message.textContent = `Quantity (${quantity}) exceeds available stock (${maxStock})`;
                warning.classList.remove('d-none');
            } else if (quantity === maxStock) {
                message.textContent = `Warning: Using all available stock (${maxStock})`;
                warning.classList.remove('d-none');
            } else {
                warning.classList.add('d-none');
            }
        });

        // Set today as max date for delivery
        const today = new Date().toISOString().split('T')[0];
        document.querySelector('input[name="DeliveryDate"]').max = today;

        // Form validation
        document.getElementById('editForm').addEventListener('submit', function(e) {
            const deliveryDateInput = document.querySelector('input[name="DeliveryDate"]');
            const orderDate = new Date('@Model.OrderDate.ToString("yyyy-MM-dd")');
            
            if (deliveryDateInput.value) {
                const deliveryDate = new Date(deliveryDateInput.value);
                if (deliveryDate < orderDate) {
                    e.preventDefault();
                    alert('Delivery date must be after order date.');
                    deliveryDateInput.focus();
                    return false;
                }
            }
            
            const quantity = parseInt(document.getElementById('quantityInput').value);
            if (quantity < 1) {
                e.preventDefault();
                alert('Quantity must be at least 1.');
                return false;
            }
            
            return true;
        });
    </script>
}